# Maintainer: Compass contributors <https://github.com/tuna-os/compass>
#
# Compass, built from git. Installs what the Flatpak ships,
# through the same scripts/packaging/install-rust-engine.sh every non-Flatpak
# output uses, with internal programs in /usr/lib/compass as Arch expects.
#
# COMPASS_GIT_URL / COMPASS_GIT_REF let CI build the checkout under test
# instead of the published branch:
#   COMPASS_GIT_URL=file:///src COMPASS_GIT_REF=commit=<sha> makepkg

pkgname=compass-git
pkgver=0.28.2.r0.g0000000
pkgrel=1
pkgdesc='A fast, extensible command palette for Linux'
arch=('x86_64' 'aarch64')
url='https://github.com/tuna-os/compass'
license=('GPL-3.0-only')
# wgpu and winit load the graphics stack and Wayland at run time rather than
# linking them, so they are named here rather than discovered by makepkg.
depends=('gcc-libs' 'glibc' 'openssl' 'nodejs' 'wayland' 'libxkbcommon' 'hicolor-icon-theme')
makedepends=('git' 'cargo' 'npm')
optdepends=(
  'vulkan-icd-loader: Vulkan rendering'
  'libglvnd: OpenGL rendering where Vulkan is unavailable'
  'xdg-desktop-portal: the global hotkey through the GlobalShortcuts portal'
)
# Installs /usr/bin/compass and org.tunaos.compass files only, so it sits beside
# the upstream vicinae packages rather than conflicting with them.
provides=('compass')
conflicts=('compass')
options=('!lto' '!debug')
# Grants compass-input-server cap_dac_override (snippet keyword expansion).
install=compass.install
source=("compass::git+${COMPASS_GIT_URL:-https://github.com/tuna-os/compass.git}${COMPASS_GIT_REF:+#$COMPASS_GIT_REF}")
sha256sums=('SKIP')

pkgver() {
  cd compass
  printf '0.28.2.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd compass
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd compass
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p compass -p compass-sandbox -p compass-input-server --bins
  # The extension runtime bundle: npm bundles the committed protocol bindings.
  # The Flatpak builds it the same way, outside flatpak-builder.
  ./scripts/build-extension-runtime.sh
}

check() {
  cd compass
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release -p compass-core --test config_schema --test config_migration
}

package() {
  cd compass
  DESTDIR="$pkgdir" PREFIX=/usr LIBEXECDIR=/usr/lib BIN_DIR=target/release REQUIRE_RUNTIME=1 \
    ./scripts/packaging/install-rust-engine.sh
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
