# vicinae-input-server reads /dev/input and writes /dev/uinput for snippet
# keyword expansion. Like the C++ helper (`make postbuild`), it gets
# cap_dac_override rather than the user joining the input group: the
# capability is on one small program that talks only to its parent.

post_install() {
  setcap cap_dac_override+ep /usr/lib/vicinae/vicinae-input-server
}

post_upgrade() {
  post_install
}
