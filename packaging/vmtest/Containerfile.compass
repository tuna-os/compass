# Bluefin with compass in it: the image the VM tier actually tests.
#
# #18 step 2. The first VM job (Containerfile.bluefin) boots stock Bluefin and
# proves only that a GNOME desktop comes up and paints under QEMU on a hosted
# runner. That was deliberate — layering our software in at the same time would
# have meant a failure could be either half. This file is the second half.
#
# Three things are added, and nothing else:
#
#   1. the compass Flatpak, as a single-file bundle built by the Flatpak
#      workflow in the same CI run;
#   2. GDM autologin, so the run reaches a real user session rather than a
#      greeter — every interesting doctor check (session bus, portals, session
#      type) is meaningless at a login screen;
#   3. a CMD, for the same corral/podman reason as Containerfile.bluefin.
#
# The GNOME Shell extension that #18 also lists is NOT here: this repository
# does not contain one yet (ADR-0004 — we speak to it, we never ship it), so
# there is nothing to install. `doctor`'s gnome.shell-extension check will
# report it absent, which is the honest answer.

FROM ghcr.io/ublue-os/bluefin:stable

# ── where the Flatpak goes, and why it is not the system installation ────────
#
# A bootc image's /var is not image content: it is copied in once at install
# time and is machine state thereafter. The system Flatpak installation lives in
# /var/lib/flatpak, so `flatpak install --system` at container-build time is
# exactly the pattern Universal Blue avoids — it works, until a rebase, and then
# the apps are silently the old ones. Their own images install Flatpaks from a
# first-boot service for this reason.
#
# A first-boot service would need network in the guest and would race the
# session we are trying to test. So instead the app goes in a *named extra
# installation* under /usr, which is image content and is what bootc actually
# versions. Flatpak reads these from /etc/flatpak/installations.d, `flatpak run`
# finds apps in them without being told, and the systemd environment generator
# adds their exports to XDG_DATA_DIRS so the desktop file is visible too.
RUN mkdir -p /usr/lib/compass-flatpak /etc/flatpak/installations.d && \
    printf '[Installation "compass"]\nPath=/usr/lib/compass-flatpak\nDisplayName=Compass (image)\n' \
      > /etc/flatpak/installations.d/compass.conf

# The bundle carries the app and nothing else, so the runtime still has to come
# from somewhere. It comes from Flathub *here*, during the image build, where
# there is network — never in the guest, which is offline by the time it matters.
COPY com.vicinae.Vicinae.flatpak /tmp/com.vicinae.Vicinae.flatpak
RUN flatpak remote-add --installation=compass --if-not-exists \
      flathub https://flathub.org/repo/flathub.flatpakrepo && \
    flatpak install --installation=compass --noninteractive --assumeyes \
      flathub org.freedesktop.Platform//26.08 && \
    flatpak install --installation=compass --noninteractive --assumeyes \
      --bundle /tmp/com.vicinae.Vicinae.flatpak && \
    rm -f /tmp/com.vicinae.Vicinae.flatpak && \
    flatpak --installation=compass list --columns=ref,origin

# ── two probe Flatpaks, one per installation root ────────────────────────────
#
# #105: Flatpak applications did not appear in search, because the manifest
# granted the `exports/share/applications` directories and not the `app` trees
# they symlink into. Nothing caught it, and this is why: the VM has Compass in
# a *named extra* installation and nothing at all in the system or user roots,
# so the two code paths the bug lived in were never exercised here.
#
# So one small application goes into each. What is asserted is that the engine
# finds them (`checks.sh flatpak-apps`), which is only true if the exported
# symlink resolves inside our sandbox.
#
# `--no-deps`, deliberately. These are never run — the test is that they are
# *indexed* — and without it each would drag in a runtime we have no use for.
# It also removes a dependency on which runtime version a third party happens
# to build against this month, which is the kind of thing that turns someone
# else's release into our red run.
#
# Installed here, during the image build, for the same reason the runtime is:
# there is network here and none in the guest. /var is seeded from the image at
# install time, so both roots reach the booted system.
# What the system step printed the first time it ran, which is the whole
# premise of the #105 fix, observed rather than argued:
#
#   + test -L /var/lib/flatpak/exports/share/applications/org.pipewire.Helvum.desktop
#   + readlink -f …
#   /var/lib/flatpak/app/org.pipewire.Helvum/x86_64/stable/022868f8…/export/share/applications/org.pipewire.Helvum.desktop
#
# The export is a symlink, and it resolves into the deploy tree. A sandbox
# granted only the exports directory cannot follow it.
#
# The `bwrap: Creating new namespace failed: Operation not permitted` lines that
# accompany the install are flatpak's post-install triggers (the desktop and
# mime database updates) failing inside a container build, which has no
# namespace privileges. They are noise, not failure: the install completes and
# the export is written, as the readlink above shows.
ARG PROBE_SYSTEM_APP=org.pipewire.Helvum
ARG PROBE_USER_APP=org.gottcode.CuteMaze
RUN set -eux; \
    flatpak remote-add --system --if-not-exists \
      flathub https://flathub.org/repo/flathub.flatpakrepo; \
    flatpak install --system --noninteractive --assumeyes --no-deps \
      flathub "$PROBE_SYSTEM_APP"; \
    test -L "/var/lib/flatpak/exports/share/applications/$PROBE_SYSTEM_APP.desktop"; \
    readlink -f "/var/lib/flatpak/exports/share/applications/$PROBE_SYSTEM_APP.desktop"

# ── the session user, and autologin ──────────────────────────────────────────
#
# The account is created HERE rather than by corral's `--user compass`, and that
# is a workaround for an upstream bug rather than a preference.
#
# Asking corral for a user makes it derive a thin image layer, and its layer
# builder pulls the base image unconditionally (pkg/vmtest/image.go, "the base
# image has to be local before anything can be read out of it"). For a
# localhost/ reference there is nothing to pull, so podman reads "localhost" as
# a registry and the run dies at exit 3:
#
#   podman pull localhost/bluefin-compass:ci: ... pinging container registry
#   localhost: Get "https://localhost/v2/": dial tcp [::1]:443: connection refused
#
# corral already knows this: pkg/bootc/local.go guards exactly this case with
# `isLocalRef` before its own pull, with a comment explaining that a locally
# built image is the whole point. The guard is simply missing from the layer
# builder — a two-line upstream fix, and the second corral bug this tier has
# found on locally built bootc images.
#
# Doing it ourselves costs nothing, because corral's layer was never how the
# checks get in: `bootc install --root-ssh-authorized-keys` injects the run's
# key for root during the disk build, with no layer involved, and the checks
# already run as root and reach the user with runuser.
#
# /var/home, not /home: on a bootc system /home is a symlink into /var, and /var
# from the image is seeded once at install time — so a home directory created
# here reaches the installed system, while one created on first boot would not
# survive a rebase.
RUN mkdir -p /var/home && \
    useradd --create-home --home-dir /var/home/compass --shell /bin/bash compass && \
    id compass

# The user half, which needs the account to exist.
#
# DONE AS ROOT AND THEN CHOWNED, not with `runuser -u compass`. That was the
# first shape and it failed the image build:
#
#   + runuser -u compass -- env HOME=/var/home/compass flatpak remote-add --user …
#   error: GPG: Unable to configure context: Permission denied
#
# gpgme wants somewhere of its own to work in, and a `runuser` inside a
# container build is not a session: there is no XDG_RUNTIME_DIR and no
# /run/user/1000 for it to use. The same command as root, which already
# installed the system half two steps up, has no such trouble.
#
# `flatpak --user` picks its installation from $XDG_DATA_HOME, so that is set
# explicitly rather than left to be derived from $HOME -- a stray XDG_DATA_HOME
# in the build environment would otherwise silently put the app somewhere
# nobody looks. The path is the one the compass user's session will resolve to.
#
# The chown is what makes it theirs. Without it the files are root's and the
# user's flatpak would refuse its own installation.
ARG PROBE_USER_DATA=/var/home/compass/.local/share
RUN set -eux; \
    env HOME=/var/home/compass XDG_DATA_HOME="$PROBE_USER_DATA" \
      flatpak remote-add --user --if-not-exists \
        flathub https://flathub.org/repo/flathub.flatpakrepo; \
    env HOME=/var/home/compass XDG_DATA_HOME="$PROBE_USER_DATA" \
      flatpak install --user --noninteractive --assumeyes --no-deps \
        flathub "$PROBE_USER_APP"; \
    chown -R compass:compass /var/home/compass; \
    test -L "$PROBE_USER_DATA/flatpak/exports/share/applications/$PROBE_USER_APP.desktop"; \
    readlink -f "$PROBE_USER_DATA/flatpak/exports/share/applications/$PROBE_USER_APP.desktop"; \
    test "$(stat -c %U "$PROBE_USER_DATA/flatpak")" = compass

# ── no first-run tour ────────────────────────────────────────────────────────
#
# Every frame this tier captured used to have "Welcome to Bluefin (Version: …)"
# centred on it, with Skip and Take Tour — GNOME Tour, which Bluefin rebrands.
# It sat in the middle of the screen, which is exactly where the launcher opens,
# so the launcher gate was measuring a window partly hidden behind a dialog and
# the artifacts were hard for a human to read.
#
# It is not autostarted by a desktop file of its own — org.gnome.Tour.desktop
# has no AutostartCondition. It is started on a user's first login through
# gnome-initial-setup's first-login autostart entry, which is gated on
#
#     AutostartCondition=unless-exists gnome-initial-setup-done
#
# so the way GNOME provides to say "this user has been through it" is to create
# that file. Doing that rather than deleting an autostart entry means we are
# using the package's own mechanism, and it keeps working if Bluefin renames or
# repackages the tour.
#
# /var/home is seeded from the image at install time (see the note above), so a
# file written here reaches the installed system.
#
# The grep below is diagnostic, not an assertion, and the difference is
# deliberate. The condition is how GNOME documents this, but which package in
# this image carries it — gnome-initial-setup, gnome-tour, or something Bluefin
# adds — is the image's business and may change under us. Failing the build on
# it would turn a cosmetic regression into a red tier; printing it means that if
# a later run's frames still show a dialog, the build log already says whether
# the mechanism was there to be used. The frame is the real check, and this tier
# captures one either way.
RUN install -d -o compass -g compass -m 0755 /var/home/compass/.config && \
    printf 'yes\n' > /var/home/compass/.config/gnome-initial-setup-done && \
    chown compass:compass /var/home/compass/.config/gnome-initial-setup-done && \
    ls -l /var/home/compass/.config/gnome-initial-setup-done && \
    echo '-- autostart entries gated on gnome-initial-setup-done --' && \
    grep -rl gnome-initial-setup-done /etc/xdg/autostart /usr/share/gnome/autostart 2>/dev/null \
      || echo 'NONE FOUND: no autostart entry references the condition in this image'

# WaylandEnable is spelled out rather than left to the default: the whole point
# of this tier is that compass is Wayland-only, and a silent fallback to Xorg
# would turn a real failure into a green run.
RUN printf '[daemon]\nWaylandEnable=true\nAutomaticLoginEnable=True\nAutomaticLogin=compass\n' \
      > /etc/gdm/custom.conf

# ── the readiness marker ─────────────────────────────────────────────────────
#
# `Started gdm.service` is the wrong marker and cost a red run to learn: it
# fires as GDM takes the DRM device and blanks it, so corral — which captures
# its final frame at readiness and does not retry — sampled a deliberately
# blank screen and `--require-paint` failed at deviation exactly 0.0000. This
# unit announces a *state* instead: logind reports a graphical session.
COPY wait-graphical.sh /usr/libexec/compass-vmtest/wait-graphical.sh
COPY compass-vmtest-graphical.service /usr/lib/systemd/system/compass-vmtest-graphical.service
RUN chmod 0755 /usr/libexec/compass-vmtest/wait-graphical.sh && \
    systemctl enable compass-vmtest-graphical.service

# ── sshd ─────────────────────────────────────────────────────────────────────
#
# corral's checks and diagnostics all arrive over SSH, and `bootc install
# --root-ssh-authorized-keys` puts the run's key in root's authorized_keys — but
# a key is no use if nothing is listening. Bluefin is a desktop image and does
# not enable sshd, so both VM jobs failed with
#
#   kex_exchange_identification: read: Connection reset by peer
#
# which reads like a broken sshd and is not one: QEMU's user-mode hostfwd
# accepts the connection on the host and the guest resets it because no process
# holds port 22. "Refused" would have been the clearer message; the reset is an
# artifact of the forward.
#
# Enabling it is a test-image change and nothing more — it is off in what ships.
RUN systemctl enable sshd.service

# ── the GlobalShortcuts consent, pre-seeded ──────────────────────────────────
#
# Spike A's headline question — does a keypress reach us? — has been UNKNOWN
# rather than answered, and not because injecting a key is hard. `BindShortcuts`
# never returned, so no binding ever existed for a key to trigger.
#
# Reading the three components settles why, and how to get past it:
#
#   1. xdg-desktop-portal's frontend includes xdp-permissions.h and never calls
#      it. There is no portal-level permission for GlobalShortcuts, so there is
#      nothing to pre-seed there.
#   2. xdg-desktop-portal-gnome forwards straight to
#      org.gnome.Settings.GlobalShortcutsProvider with the proxy timeout set to
#      G_MAXINT — no timeout, deliberately, because a human may take arbitrarily
#      long at a dialog. "No answer in 30s" is the designed behaviour when
#      nobody answers, not a slow software renderer.
#   3. gnome-control-center's cc_global_shortcut_dialog_present opens with
#
#          if (!self->has_new_shortcuts) { emit_done (self, TRUE); return; }
#
#      and has_new_shortcuts is false when every requested shortcut id is
#      already stored for the app. That path stores and returns the full set,
#      so BindShortcuts gets a proper reply — not an empty one.
#
# "Already stored" is GSettings on a relocatable schema, which means dconf,
# which means image content. Seeding the id the spike asks for is therefore
# enough to make the bind complete unattended.
#
# The keyfile is written as a system database rather than into the user's
# ~/.config/dconf/user: /var/home is machine state on a bootc image and is
# seeded at install time, so a user database written here is the kind of thing
# that works until it silently does not. A system db is also not a lock — when
# the provider stores the grant it writes to the user db, which shadows this
# one, exactly as it would for a human who clicked the dialog.
#
# This is a test-image change. Nothing ships pre-granting itself a hotkey.
#
# The two assertions after `dconf update` are there because it is not loud
# enough on its own: a profile that never referenced our database, or a keyfile
# it declined to compile, both leave a build that succeeded and a guest with no
# grant — which presents as Spike A hanging exactly as it did before, thirty
# minutes later. The grep reads a binary GVDB file and is only checking that the
# app id survived into it; whether the *value* is right is answered in the guest
# by `checks.sh spike-a-evidence`, which reads it the way GNOME will.
COPY compass-shortcuts.dconf /etc/dconf/db/compass.d/10-compass-shortcuts
COPY compass-session.dconf /etc/dconf/db/compass.d/20-compass-session
RUN set -eux; \
    mkdir -p /etc/dconf/profile; \
    if [ -f /etc/dconf/profile/user ]; then \
      grep -qx 'system-db:compass' /etc/dconf/profile/user \
        || printf 'system-db:compass\n' >> /etc/dconf/profile/user; \
    else \
      printf 'user-db:user\nsystem-db:compass\n' > /etc/dconf/profile/user; \
    fi; \
    cat /etc/dconf/profile/user; \
    dconf update; \
    test -f /etc/dconf/db/compass; \
    grep -q com.vicinae.Vicinae /etc/dconf/db/compass; \
    grep -q welcome-dialog-last-shown-version /etc/dconf/db/compass

# ── the corpus harvester ─────────────────────────────────────────────────────
#
# Phase 1's gate wants Suite 0 ranking parity over ~500 real desktop entries and
# the corpus has 27, which §11.2 identifies as the binding constraint on the
# whole phase. `scripts/harvest-desktop-corpus.sh` is the tool, and its own
# header says to run it "on a real desktop — ideally a Bluefin box, since that
# is the first target and its RPM + Flatpak + Homebrew mix is what users
# actually have".
#
# This image *is* a Bluefin box with a real GNOME application set, booted fresh
# every run. The machine the script was waiting for has been in CI all along.
#
# The real script is copied in rather than reimplemented here, so there is one
# definition of what a harvest is and it is the one tier 1 already shellchecks.
# The workflow stages it into the build context alongside the Flatpak bundle.
COPY harvest-desktop-corpus.sh /usr/libexec/compass-vmtest/harvest-desktop-corpus.sh
RUN chmod 0755 /usr/libexec/compass-vmtest/harvest-desktop-corpus.sh

# ── the assertions ───────────────────────────────────────────────────────────
#
# Baked in rather than pushed over SSH so that they are a real file in the
# repository: `bash -n` and a Python compile check run over them in tier 1,
# before a 30-minute VM run finds a quoting mistake.
COPY checks.sh /usr/libexec/compass-vmtest/checks.sh
RUN chmod 0755 /usr/libexec/compass-vmtest/checks.sh

# Never executed. See Containerfile.bluefin: corral `podman create`s the image
# to probe its filesystem, and podman refuses an image with no CMD.
CMD ["/bin/bash"]
