# Stock Bluefin, made testable: a CMD podman will accept, and a readiness marker.
#
# WHY THIS EXISTS — delete it once corral is fixed.
#
# corral probes a bootc image's filesystem before building a disk from it:
# `pkg/bootc.DetectBackend` looks for bootupctl vs systemd-boot to pick the
# backend, and `pkg/vmtest.DetectPackageManager` looks for dnf/apt/etc. Both do
# it by `podman create`-ing a container and `podman cp`-ing paths out of it,
# deliberately never executing anything — their comments explain that Universal
# Blue images ship Rust uutils, where running a binary through
# `podman --entrypoint` misdetects exactly the images this matters most for.
#
# But `podman create` still refuses an image with no CMD and no ENTRYPOINT, and
# ghcr.io/ublue-os/bluefin has neither, because a bootc OS image is not meant to
# be run as an app container. So corral fails on the exact image family the probe
# was written for:
#
#   podman create ghcr.io/ublue-os/bluefin:stable: Error: no command or
#   entrypoint provided, and no CMD or ENTRYPOINT from image
#
# `DetectBackend`'s failure is fatal (corral exit 4, "the disk build failed").
# `DetectPackageManager`'s is tolerated unless packages were requested.
#
# The upstream fix is one word — `podman create --entrypoint=""`, or passing a
# dummy command — since neither probe ever starts the container. Until that
# lands, adding a CMD here makes the image createable. CMD itself changes no OS
# content: it is metadata that a bootc install ignores entirely.
#
# The readiness marker below IS OS content, and it is the one thing this control
# image adds beyond stock Bluefin. It observes; it changes nothing about how the
# desktop comes up.
FROM ghcr.io/ublue-os/bluefin:stable

# ── the readiness marker ─────────────────────────────────────────────────────
#
# `Started gdm.service` is the wrong marker and cost a red run to learn: it
# fires as GDM takes the DRM device and blanks it, so corral — which captures
# its final frame at readiness and does not retry — sampled a deliberately
# blank screen and `--require-paint` failed at deviation exactly 0.0000. This
# unit announces a *state* instead: logind reports a graphical session.
COPY wait-graphical.sh /usr/libexec/compass-vmtest/wait-graphical.sh
COPY compass-vmtest-graphical.service /usr/lib/systemd/system/compass-vmtest-graphical.service
RUN chmod 0755 /usr/libexec/compass-vmtest/wait-graphical.sh && \
    systemctl enable compass-vmtest-graphical.service

# Never executed. Present only so `podman create` has something to record.
CMD ["/bin/bash"]
