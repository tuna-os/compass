// CLI / browser extension <-> server IPC protocol
// Served over a Unix domain socket at $XDG_RUNTIME_DIR/vicinae/vicinae.sock

struct PingResponse {
  version: string;
  pid: int;
};

struct DeeplinkRequest {
  url: string;
};

struct DeeplinkResponse {
  error?: string;
};

struct DescribeResponse {
  open: bool;
  entrypoint: string;
};

struct LaunchAppRequest {
  appId: string;
  args: string[];
  newInstance: bool;
};

struct LaunchAppResponse {
  error?: string;
  focusedWindowTitle: string;
};

struct LaunchCommandRequest {
  entrypoint: string;
  args: string[];
  cwd?: string;
  query?: string;
};

struct LaunchCommandResponse {
  error?: string;
};

struct CommandInfo {
  id: string;
  name: string;
};

struct ListCommandsResponse {
  commands: CommandInfo[];
};

enum DMenuOutputFormat {
  Data,
  Index
};

struct DMenuRequest {
  rawContent: string;
  navigationTitle?: string;
  placeholder?: string;
  format: DMenuOutputFormat;
  sectionTitle?: string;
  noSection: bool;
  noQuickLook: bool;
  noIcon: bool;
  noMetadata: bool;
  query?: string;
  width?: int;
  height?: int;
  noFooter: bool;
};

struct DMenuResponse {
  output: string;
};

struct BrowserInitRequest {
  id: string;
  name: string;
  engine: string;
};

struct BrowserTabInfo {
  id: int;
  windowId: int;
  title: string;
  url: string;
  active: bool;
  muted: bool;
  audible: bool;
  lastAccessed: double;
};

struct FocusTabRequest {
  tabId: int;
};

struct CloseTabRequest {
  tabId: int;
};

struct FileResult {
  path: string;
  score: uint;
  category: string;
  mimeType?: string;
};

struct RootHit {
  id: string;
  title: string;
  subtitle?: string;
  score: double;
};

struct RootQueryParams {
  limit: int;
  providerId?: string;
  includeDisabled: bool;
};

struct FsQueryParams {
  limit: int;
  category?: string;
};

service Ipc {
  fn ping() => PingResponse;
  fn deeplink(req: DeeplinkRequest) => DeeplinkResponse;
  fn describe() => DescribeResponse;
  fn launchApp(req: LaunchAppRequest) => LaunchAppResponse;
  fn listCommands() => ListCommandsResponse;
  fn launchCommand(req: LaunchCommandRequest) => LaunchCommandResponse;
  fn dmenu(req: DMenuRequest) => DMenuResponse;
  fn browserInit(req: BrowserInitRequest) => void;
  fn browserTabsChanged(tabs: BrowserTabInfo[]) => void;

  // Root-item ranking, for the Suite 0 differential (PLAN.md 8.1a rung 2).
  //
  // Not a UI surface: nothing in the launcher calls it. It exists so the two
  // engines' RANKING can be diffed, which every other parity test we have
  // cannot do -- they compare the port against our reading of the C++ source
  // rather than against its behaviour.
  //
  // `score` is the value the engine ORDERS BY, which on this side includes the
  // frecency boost and is therefore not the 0..=100 match score the Rust
  // engine reports. The two scales are a declared divergence; the comparison
  // is over ids in order. See PARITY.md.
  fn rootQuery(q: string, params: RootQueryParams) => RootHit[];

  // filesystem
  fn fsQuery(q: string, params: FsQueryParams) => FileResult[];

  event focusTab(req: FocusTabRequest);
  event closeTab(req: CloseTabRequest);
}
